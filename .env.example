# 复制为 .env 后按需修改：cp .env.example .env
# 所有配置项及说明见 src/servicekb/config.py

# ============================================================ 方案 A：离线体验（默认，什么都不用装）
SERVICEKB_STORE_BACKEND=memory
SERVICEKB_EMBEDDING_BACKEND=hashing
SERVICEKB_EMBEDDING_DIM=512
SERVICEKB_LLM_PROVIDER=extractive

# ============================================================ 方案 B：Postgres + 本地 GPU 模型 + 大模型 API（推荐生产起步）
# SERVICEKB_STORE_BACKEND=postgres
# SERVICEKB_DATABASE_URL=postgresql://servicekb:servicekb@localhost:5432/servicekb
#
# --- 向量模型：二选一 ---
# (1) 直接在本进程里加载（需要 pip install -e ".[local]"，有 GPU）
# SERVICEKB_EMBEDDING_BACKEND=sentence_transformers
# SERVICEKB_EMBEDDING_MODEL=BAAI/bge-m3
# SERVICEKB_EMBEDDING_DIM=1024
# SERVICEKB_EMBEDDING_DEVICE=cuda:0
# (2) 调用独立部署的 TEI 服务（docker compose --profile gpu up，推荐）
# SERVICEKB_EMBEDDING_BACKEND=openai
# SERVICEKB_EMBEDDING_BASE_URL=http://localhost:8080/v1
# SERVICEKB_EMBEDDING_MODEL=BAAI/bge-m3
# SERVICEKB_EMBEDDING_DIM=1024
#
# --- 重排模型 ---
# SERVICEKB_RERANKER_BACKEND=tei
# SERVICEKB_RERANKER_URL=http://localhost:8081
# SERVICEKB_RERANKER_MIN_SCORE=0.15
#
# --- 大模型：选一家（完整列表：servicekb llm providers；说明：docs/11_llm_providers.md）---
# 测试是否调通：servicekb llm test
#
# (1) OpenAI 官方
# SERVICEKB_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# SERVICEKB_LLM_MODEL=gpt-4.1-mini           # 换成你们账号可用的模型
#
# (2) Claude（pip install -e ".[anthropic]"）
# SERVICEKB_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# SERVICEKB_LLM_MODEL=claude-opus-5-5        # 不填默认就是它
# SERVICEKB_LLM_EFFORT=medium                # 思考深度 low / medium / high / xhigh / max
# SERVICEKB_ANTHROPIC_SERVER_FALLBACKS=true  # 被拒答时服务端自动换模型重跑（仅官方 API）
#   Bedrock：SERVICEKB_LLM_PROVIDER=anthropic_bedrock  SERVICEKB_AWS_REGION=us-east-1
#   Vertex ：SERVICEKB_LLM_PROVIDER=anthropic_vertex   SERVICEKB_GCP_PROJECT_ID=my-project
#
# (3) Azure OpenAI（model 填部署名）
# SERVICEKB_LLM_PROVIDER=azure_openai
# SERVICEKB_LLM_BASE_URL=https://<资源名>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# SERVICEKB_LLM_MODEL=<部署名>
#
# (4) 国内厂商 / Gemini（OpenAI 兼容接口，地址已内置）
# SERVICEKB_LLM_PROVIDER=deepseek            # 或 qwen / moonshot / zhipu / gemini
# DEEPSEEK_API_KEY=sk-...                    # 各家的 Key 变量名见 servicekb llm providers
# SERVICEKB_LLM_MODEL=deepseek-chat
#
# (5) 本地 vLLM（96GB 卡可跑 30B 级别模型；数据不出公司）
# SERVICEKB_LLM_PROVIDER=vllm
# SERVICEKB_LLM_BASE_URL=http://localhost:8000/v1
# SERVICEKB_LLM_MODEL=Qwen/Qwen3-32B
#
# --- 主备切换：主模型报错 / 超时 / 拒答时，按顺序换备用厂家（JSON 数组）---
# SERVICEKB_LLM_FALLBACKS=[{"provider":"vllm","model":"Qwen/Qwen3-32B","base_url":"http://gpu-box:8000/v1"}]

# ============================================================ 拍照识别备件（docs/10）
# 默认：手工特征 + OCR 自动选择（装了 rapidocr 就用，否则只读样例图片里预置的标签）
# SERVICEKB_IMAGE_EMBEDDING_BACKEND=handcrafted
# --- 生产：本地 SigLIP（pip install -e ".[vision]"）---
# SERVICEKB_IMAGE_EMBEDDING_BACKEND=siglip
# SERVICEKB_IMAGE_EMBEDDING_MODEL=google/siglip-so400m-patch14-384
# --- 或者：调用已部署的图像编码服务（POST {"images":[b64...]} → {"embeddings":[[...]]}）---
# SERVICEKB_IMAGE_EMBEDDING_BACKEND=http
# SERVICEKB_IMAGE_EMBEDDING_URL=http://gpu-box:8090/embed
# SERVICEKB_IMAGE_EMBEDDING_DIM=1152
# --- OCR（pip install -e ".[ocr]"）---
# SERVICEKB_OCR_BACKEND=rapidocr
# --- 阈值：换了模型 / 照片来源后必须用 servicekb photo eval 重新校准 ---
# SERVICEKB_PHOTO_MIN_VISUAL_SCORE=0.80
# SERVICEKB_PHOTO_LOOKALIKE_MARGIN=0.03

# ============================================================ API 服务（上线前跑一遍 servicekb doctor，见 docs/12）
# 可信网关用的 Key（可访问任意用户组）。JSON 数组；为空且 API_CLIENTS 也为空 = 不鉴权（仅限本地开发）
# SERVICEKB_API_KEYS=["change-me-long-random-string"]
# 按调用方分配 Key + 允许的用户组（最小权限）：X-User-Groups 里超出范围的组会被丢弃
# SERVICEKB_API_CLIENTS=[{"name":"teams-bot","key":"change-me-too","groups":["public","service"]}]
SERVICEKB_LOG_LEVEL=INFO
# SERVICEKB_LOG_JSON=true                        # 生产建议开启
#
# --- 并发与过载保护（每个进程）---
# WEB_CONCURRENCY=4                              # servicekb serve 的进程数；K8s 里建议 1，靠副本扩容
# SERVICEKB_MAX_CONCURRENT_REQUESTS=16           # 同时处理的 ask / search / photo 请求上限，超出排队后返回 503
# SERVICEKB_OVERLOAD_WAIT_S=5
# SERVICEKB_RETRIEVAL_MAX_WORKERS=48             # 召回线程池，≥ 3 × 并发上限
# SERVICEKB_DB_POOL_MAX_SIZE=20                  # ≥ 并发上限；总连接数 = 进程数 × 该值，别超过数据库 max_connections
#
# --- 超时 / 熔断（依赖故障时快速降级，而不是让请求挂住）---
# SERVICEKB_EMBEDDING_TIMEOUT_S=30
# SERVICEKB_RERANKER_TIMEOUT_S=10
# SERVICEKB_RETRIEVAL_CHANNEL_TIMEOUT_S=10
# SERVICEKB_LLM_CIRCUIT_FAILURES=3               # 某个大模型厂家连续失败 N 次后跳过它 cooldown 秒
# SERVICEKB_LLM_CIRCUIT_COOLDOWN_S=30
#
# --- 监控 / 隐私 ---
# SERVICEKB_METRICS_ENABLED=true                 # GET /metrics（Prometheus），不要暴露到公网
# PROMETHEUS_MULTIPROC_DIR=/tmp/prom             # 多进程部署时汇总各进程指标（每次启动前清空）
# SERVICEKB_QUERY_LOG_REDACT_PII=true            # 查询日志脱敏（手机号 / 邮箱 / 身份证号）
# SERVICEKB_QUERY_LOG_RETENTION_DAYS=180         # servicekb db prune-logs 默认保留天数

# ============================================================ SharePoint / Teams（Microsoft Graph）
# SERVICEKB_GRAPH_TENANT_ID=
# SERVICEKB_GRAPH_CLIENT_ID=
# SERVICEKB_GRAPH_CLIENT_SECRET=
