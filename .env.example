# 复制为 .env 后按需修改：cp .env.example .env
# 所有配置项及说明见 src/servicekb/config.py

# ============================================================ 方案 A：离线体验（默认，什么都不用装）
SERVICEKB_STORE_BACKEND=memory
SERVICEKB_EMBEDDING_BACKEND=hashing
SERVICEKB_EMBEDDING_DIM=512
SERVICEKB_LLM_BACKEND=extractive

# ============================================================ 方案 B：Postgres + 本地 GPU 模型 + OpenAI（推荐生产起步）
# SERVICEKB_STORE_BACKEND=postgres
# SERVICEKB_DATABASE_URL=postgresql://servicekb:servicekb@localhost:5432/servicekb
#
# --- 向量模型：二选一 ---
# (1) 直接在本进程里加载（需要 pip install -e ".[local]"，有 GPU）
# SERVICEKB_EMBEDDING_BACKEND=sentence_transformers
# SERVICEKB_EMBEDDING_MODEL=BAAI/bge-m3
# SERVICEKB_EMBEDDING_DIM=1024
# SERVICEKB_EMBEDDING_DEVICE=cuda:0
# (2) 调用独立部署的 TEI 服务（docker compose --profile gpu up，推荐）
# SERVICEKB_EMBEDDING_BACKEND=openai
# SERVICEKB_EMBEDDING_BASE_URL=http://localhost:8080/v1
# SERVICEKB_EMBEDDING_MODEL=BAAI/bge-m3
# SERVICEKB_EMBEDDING_DIM=1024
#
# --- 重排模型 ---
# SERVICEKB_RERANKER_BACKEND=tei
# SERVICEKB_RERANKER_URL=http://localhost:8081
# SERVICEKB_RERANKER_MIN_SCORE=0.15
#
# --- 大模型：OpenAI 官方 ---
# SERVICEKB_LLM_BACKEND=openai
# SERVICEKB_LLM_API_KEY=sk-...
# SERVICEKB_LLM_MODEL=gpt-4o-mini        # 换成你们账号可用的模型
# --- 或者：本地 vLLM（96GB 卡可跑 30B 级别模型）---
# SERVICEKB_LLM_BASE_URL=http://localhost:8000/v1
# SERVICEKB_LLM_MODEL=Qwen/Qwen3-32B
# SERVICEKB_LLM_API_KEY=EMPTY

# ============================================================ API 服务
# JSON 数组格式；为空表示不鉴权（仅限本地开发）
# SERVICEKB_API_KEYS=["change-me-long-random-string"]
SERVICEKB_LOG_LEVEL=INFO
# SERVICEKB_LOG_JSON=true

# ============================================================ SharePoint / Teams（Microsoft Graph）
# SERVICEKB_GRAPH_TENANT_ID=
# SERVICEKB_GRAPH_CLIENT_ID=
# SERVICEKB_GRAPH_CLIENT_SECRET=
