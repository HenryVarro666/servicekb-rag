{"id": "c6", "replyToId": null, "messageType": "message", "createdDateTime": "2026-07-02T06:00:00Z", "lastModifiedDateTime": "2026-07-02T06:00:00Z", "lastEditedDateTime": null, "deletedDateTime": null, "subject": null, "importance": "normal", "locale": "en-us", "policyViolation": null, "eventDetail": null, "from": {"application": null, "device": null, "user": {"id": "u-1003", "displayName": "孙七", "userIdentityType": "aadUser"}}, "body": {"contentType": "html", "content": "<p>请教：AS-8K-RS 一下雨就报 E044 是什么原因？</p>"}, "attachments": [], "mentions": [], "reactions": [], "chatId": "19:group-chat-wifi@thread.v2", "channelIdentity": null, "webUrl": "https://teams.microsoft.com/l/message/19:group-chat-wifi@thread.v2/c6?context=%7B%22contextType%22%3A%22chat%22%7D"}
